<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/tagline"
            android:textColor="@color/muted" />

        <Button
            android:id="@+id/toggle"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:background="@drawable/circle_off"
            android:elevation="6dp"
            android:gravity="center"
            android:stateListAnimator="@null"
            android:text="@string/toggle_off"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textColor="@color/text"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/blocked_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/accent"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/blocked_label"
            android:textColor="@color/text" />

        <TextView
            android:id="@+id/query_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/list_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@color/card"
            android:padding="14dp"
            android:text="@string/tip"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/advanced_toggle"
            style="@android:style/Widget.Material.Button.Borderless.Colored"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/show_advanced" />

        <LinearLayout
            android:id="@+id/advanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/always_on" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/always_on_hint"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/always_on"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/always_on" />

            <TextView
                style="@style/SectionTitle"
                android:text="@string/recent_title" />

            <LinearLayout
                android:id="@+id/recent_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/SectionTitle"
                android:text="@string/lists_title" />

            <LinearLayout
                android:id="@+id/sources"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/update_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/update_now" />

            <TextView
                style="@style/SectionTitle"
                android:text="@string/dns_title" />

            <RadioGroup
                android:id="@+id/upstreams"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/SectionTitle"
                android:text="@string/allow_title" />

            <EditText
                android:id="@+id/allow_edit"
                style="@style/RulesBox" />

            <TextView
                style="@style/SectionTitle"
                android:text="@string/block_title" />

            <EditText
                android:id="@+id/block_edit"
                style="@style/RulesBox" />

            <Button
                android:id="@+id/save_rules"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/save" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
